    "miseEnPlace": [
      {
        "text": "Set the butter and eggs out to take the chill off.",
        "inputs": [
          "butter",
          "eggs"
        ]
      },
      {
        "text": "Preheat the oven and line the sheet pans with parchment.",
        "usesEquipment": [
          "oven",
          "sheet-pan",
          "parchment"
        ]
      },
      {
        "text": "Weigh and whisk the dry ingredients together.",
        "inputs": [
          "flour",
          "baking-soda",
          "salt"
        ],
        "usesEquipment": [
          "mixing-bowl",
          "whisk"
        ]
      }
    ],
