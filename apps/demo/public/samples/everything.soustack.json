    "instructions": [
      {
        "section": "Mix",
        "steps": [
          {
            "id": "s-soften-and-preheat",
            "text": "Start preheating the oven to 350°F (175°C) while the butter softens and the eggs lose their chill.",
            "inputs": [
              "butter",
              "eggs"
            ],
            "usesEquipment": [
              "oven"
            ],
            "techniqueIds": [
              "t-preheat"
            ],
            "temperature": {
              "target": "oven",
              "value": 350,
              "unit": "fahrenheit",
              "approximate": true
            },
            "timing": {
              "activity": "passive",
              "duration": {
                "minutes": 15
              }
            },
            "images": [
              "https://example.com/media/choc-chip-cookies/preheat.jpg"
            ]
          },
          {
            "id": "s-mix-dry",
            "text": "Whisk flour, baking soda, and salt until evenly combined.",
            "inputs": [
              "flour",
              "baking-soda",
              "salt"
            ],
            "usesEquipment": [
              "mixing-bowl",
              "whisk"
            ],
            "techniqueIds": [
              "t-whisk"
            ],
            "timing": {
              "activity": "active",
              "duration": {
                "minutes": 2
              }
            }
          },
          {
            "id": "s-cream",
            "text": "Cream butter with both sugars until visibly lighter and fluffy.",
            "inputs": [
              "butter",
              "brown-sugar",
              "white-sugar"
            ],
            "dependsOn": [
              "s-soften-and-preheat"
            ],
            "usesEquipment": [
              "stand-mixer"
            ],
            "techniqueIds": [
              "t-cream"
            ],
            "timing": {
              "activity": "active",
              "completionCue": "mixture is pale and fluffy"
            }
          },
          {
            "id": "s-add-eggs-and-vanilla",
            "text": "Beat in the eggs one at a time, then add vanilla; mix until glossy.",
            "inputs": [
              "eggs",
              "vanilla"
            ],
            "dependsOn": [
              "s-cream"
            ],
            "usesEquipment": [
              "stand-mixer"
            ],
            "techniqueIds": [
              "t-cream"
            ],
            "timing": {
              "activity": "active",
              "duration": {
                "minMinutes": 1,
                "maxMinutes": 2
              }
            }
          },
          {
            "id": "s-fold-dry",
            "text": "Fold the dry ingredients into the wet mixture just until no dry streaks remain.",
            "inputs": [
              "flour",
              "baking-soda",
              "salt"
            ],
            "dependsOn": [
              "s-add-eggs-and-vanilla"
            ],
            "usesEquipment": [
              "mixing-bowl",
              "spatula"
            ],
            "techniqueIds": [
              "t-fold"
            ],
            "timing": {
              "activity": "active",
              "completionCue": "no visible dry flour remains"
            }
          },
          {
            "id": "s-fold-chocolate",
            "text": "Fold in the chocolate chips (and optional reserved chips for topping).",
            "inputs": [
              "chocolate-chips"
            ],
            "dependsOn": [
              "s-fold-dry"
            ],
            "usesEquipment": [
              "spatula"
            ],
            "techniqueIds": [
              "t-fold"
            ],
            "timing": {
              "activity": "active",
              "duration": {
                "minutes": 1
              }
            }
          }
        ]
      },
      {
        "section": "Portion & Bake",
        "steps": [
          {
            "id": "s-portion",
            "text": "Scoop ~30 g portions onto parchment-lined sheet pans, leaving space for spreading.",
            "inputs": [
              "chocolate-chips",
              "flour",
              "butter"
            ],
            "dependsOn": [
              "s-fold-chocolate"
            ],
            "usesEquipment": [
              "cookie-scoop",
              "sheet-pan",
              "parchment"
            ],
            "techniqueIds": [
              "t-portion"
            ],
            "timing": {
              "activity": "active",
              "duration": {
                "minutes": 5
              }
            },
            "videos": [
              "https://example.com/media/choc-chip-cookies/scoop.mp4"
            ]
          },
          {
            "id": "s-bake",
            "text": "Bake until the edges are set and lightly browned while the centers are still soft.",
            "inputs": [
              "flour",
              "butter",
              "brown-sugar",
              "white-sugar"
            ],
            "dependsOn": [
              "s-portion"
            ],
            "usesEquipment": [
              "oven",
              "sheet-pan"
            ],
            "techniqueIds": [
              "t-bake"
            ],
            "temperature": {
              "target": "oven",
              "value": 350,
              "unit": "fahrenheit"
            },
            "timing": {
              "activity": "passive",
              "duration": {
                "minMinutes": 10,
                "maxMinutes": 12
              }
            }
          },
          {
            "id": "s-cool",
            "text": "Cool on the pan for 5 minutes, then transfer to a rack to finish cooling.",
            "inputs": [
              "flour"
            ],
            "dependsOn": [
              "s-bake"
            ],
            "usesEquipment": [
              "sheet-pan",
              "cooling-rack"
            ],
            "techniqueIds": [
              "t-cool"
            ],
            "timing": {
              "activity": "passive",
              "duration": {
                "minutes": 10
              }
            }
          }
        ]
      }
    ],
