    "techniques": [
      {
        "id": "t-preheat",
        "name": "Preheating",
        "description": "Bring equipment to the target temperature before cooking."
      },
      {
        "id": "t-whisk",
        "name": "Whisking",
        "description": "Combine dry ingredients evenly without aerating too aggressively."
      },
      {
        "id": "t-cream",
        "name": "Creaming",
        "description": "Beat fat + sugar to incorporate air for lift and texture."
      },
      {
        "id": "t-fold",
        "name": "Folding",
        "description": "Gently combine to avoid overmixing and tough cookies."
      },
      {
        "id": "t-portion",
        "name": "Portioning",
        "description": "Divide dough into equal pieces for even baking."
      },
      {
        "id": "t-bake",
        "name": "Baking",
        "description": "Cook in dry heat until set; carryover finishes the center."
      },
      {
        "id": "t-cool",
        "name": "Cooling",
        "description": "Let structure set; texture continues to develop as steam escapes."
      }
